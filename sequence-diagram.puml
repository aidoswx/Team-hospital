@startuml
skinparam backgroundColor #000000
skinparam shadowing false
skinparam defaultFontColor #FFFFFF
skinparam defaultFontName DejaVu Sans
skinparam ArrowColor #FFFFFF
skinparam ArrowFontColor #FFFFFF
skinparam SequenceLifeLineBorderColor #FFFFFF
skinparam SequenceLifeLineBackgroundColor #000000
skinparam ParticipantBorderColor #FFFFFF
skinparam ParticipantBackgroundColor #000000
skinparam ParticipantFontColor #FFFFFF
skinparam ActorBorderColor #FFFFFF
skinparam ActorBackgroundColor #000000
skinparam ActorFontColor #FFFFFF

title Damumed — Sequence диаграммасы (Қабылдауға жазылу)

actor "Пациент" as P
participant "AuthService" as A
participant "Appointment" as AP
participant "Schedule" as S
participant "QueueService" as Q
actor "Дәрігер" as D
participant "MedicalRecord" as M
participant "AuditLogger" as L

P -> A : login(логин, құпиясөз)
A -> L : log(LOGIN)
A --> P : рөл = PATIENT
P -> AP : жазылу жасау(дәрігер, уақыт)
AP -> S : уақыт бос па?
S --> AP : иә, бос
AP -> Q : кезекке қосу(пациент, санат)
Q -> Q : басымдық бойынша сұрыптау
AP -> L : log(APPOINTMENT_CREATED)
AP --> P : жазылу расталды
D -> Q : келесі пациентті шақыру
Q --> D : пациент
D -> M : қабылдау нәтижесін енгізу
M -> L : log(RECORD_UPDATED)
@enduml
